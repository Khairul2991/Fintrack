# Public Supabase project URL (safe to expose in the browser bundle).
VITE_SUPABASE_URL=

# Public Supabase anon/publishable key (safe to expose - never the service-role key).
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public API base URL for production builds. Unset => requests use "/api"
# (Vite dev proxy -> http://localhost:3000, or same-origin when the API is
# served from the same host as the frontend in production).
# VITE_API_URL=https://api.example.com
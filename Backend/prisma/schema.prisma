generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "mts"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  CASH
  BANK
  SAVINGS
  EWALLET
  OTHER
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum BudgetFrequency {
  MONTHLY
  YEARLY
}

enum GoalStatus {
  IN_PROGRESS
  COMPLETED
}

enum NotificationType {
  RECURRING_DUE
  BUDGET_LIMIT
  GOAL_DEADLINE
}

model User {
  id                     Int                    @id @default(autoincrement())
  authUserId             String                 @unique
  email                  String                 @unique
  name                   String?
  createdAt              DateTime               @default(now())
  categories             Category[]
  transactions           Transaction[]
  budgets                Budget[]
  accounts               Account[]
  recurringTransactions  RecurringTransaction[]
  recurringBudgets       RecurringBudget[]
  goals                  Goal[]
  notifications          Notification[]
}

model Category {
  id                    Int             @id @default(autoincrement())
  userId                Int?
  type                  TransactionType
  name                  String
  icon                  String
  color                 String
  createdAt             DateTime        @default(now())
  isSystem              Boolean         @default(false)
  user                  User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  recurringBudgets      RecurringBudget[]
  goals                 Goal[]

  @@index([userId])
  @@index([type])
}

model Transaction {
  id                    Int                  @id @default(autoincrement())
  userId                Int
  description           String
  amount                Decimal              @db.Decimal(18, 4)
  type                  TransactionType
  categoryId            Int
  accountId             Int?
  date                  DateTime
  note                  String?
  createdAt             DateTime             @default(now())
  recurringTransactionId Int?
  user                  User                 @relation(fields: [userId], references: [id])
  category              Category             @relation(fields: [categoryId], references: [id])
  account               Account?             @relation(fields: [accountId], references: [id])
  recurringTransaction  RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([categoryId])
  @@index([accountId])
  @@index([date])
  @@index([type])
  @@index([recurringTransactionId])
}

model Budget {
  id                 Int             @id @default(autoincrement())
  userId             Int
  categoryId         Int
  month              Int
  year               Int
  amount             Decimal         @db.Decimal(18, 4)
  recurringBudgetId  Int?
  createdAt          DateTime        @default(now())
  user               User            @relation(fields: [userId], references: [id])
  category           Category        @relation(fields: [categoryId], references: [id])
  recurringBudget    RecurringBudget? @relation(fields: [recurringBudgetId], references: [id], onDelete: SetNull)

  @@unique([userId, categoryId, month, year])
  @@index([userId])
  @@index([categoryId])
  @@index([recurringBudgetId])
}

model Account {
  id                    Int                    @id @default(autoincrement())
  userId                Int
  name                  String
  type                  AccountType
  isDefault             Boolean                @default(false)
  initialBalance        Decimal                @default(0) @db.Decimal(18, 4)
  createdAt             DateTime               @default(now())
  user                  User                   @relation(fields: [userId], references: [id])
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  goals                 Goal[]

  @@unique([userId, name])
}

model RecurringTransaction {
  id             Int             @id @default(autoincrement())
  userId         Int
  description    String
  amount         Decimal         @db.Decimal(18, 4)
  type           TransactionType
  categoryId     Int
  accountId      Int?
  frequency      Frequency
  startDate      DateTime
  endDate        DateTime?
  note           String?
  active         Boolean         @default(true)
  lastRunAt      DateTime?
  nextOccurrence DateTime
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id])
  category       Category        @relation(fields: [categoryId], references: [id])
  account        Account?        @relation(fields: [accountId], references: [id])
  transactions   Transaction[]

  @@index([userId])
  @@index([categoryId])
  @@index([accountId])
}

model RecurringBudget {
  id         Int             @id @default(autoincrement())
  userId     Int
  categoryId Int
  amount     Decimal         @db.Decimal(18, 4)
  frequency  BudgetFrequency
  startMonth Int
  startYear  Int
  nextMonth  Int
  nextYear   Int
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id])
  category   Category        @relation(fields: [categoryId], references: [id])
  budgets    Budget[]

  @@index([userId])
  @@index([categoryId])
}

model Goal {
  id            Int        @id @default(autoincrement())
  userId        Int
  name          String
  description   String?
  targetAmount  Decimal    @db.Decimal(18, 4)
  currentAmount Decimal    @default(0) @db.Decimal(18, 4)
  targetDate    DateTime?
  categoryId    Int?
  accountId     Int?
  status        GoalStatus @default(IN_PROGRESS)
  createdAt     DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id])
  category      Category?  @relation(fields: [categoryId], references: [id])
  account       Account?   @relation(fields: [accountId], references: [id])

  @@index([userId])
  @@index([categoryId])
  @@index([accountId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId])
}

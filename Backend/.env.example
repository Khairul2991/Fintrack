# DATABASE_URL must be the Supabase PostgreSQL connection string.
# Production: no ?schema= param (uses public). Tests append ?schema=fintrack_test / fintrack_test_fe.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional: HTTP port for the API server (default: 3000).
# PORT=3000

# Optional: runtime mode (development / test / production). Defaults to development.
# Production enables strict CORS and guarded error logging.
# NODE_ENV=production

# Optional: production CORS. Comma-separated list of allowed frontend origins.
# Development allows http://localhost:5173 automatically. Unset in production => only same-origin.
# FRONTEND_URL=https://app.example.com,https://app.example.org

# Optional: AI Financial Insights. Leave unset to always use rule-based insights.
# AI_PROVIDER="https://api.openai.com/v1"
# AI_API_KEY="your-key-here"
# AI_MODEL="gpt-4o-mini"